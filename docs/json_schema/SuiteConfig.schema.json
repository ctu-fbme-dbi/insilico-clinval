{
  "$defs": {
    "BackgroundConfig": {
      "additionalProperties": false,
      "description": "Background genome (small-variant benchmark VCF + BED), e.g. GIAB HG002 v4.2.1 GRCh38.",
      "properties": {
        "bed": {
          "title": "Bed",
          "type": "string"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "skip records with a longer allele (event_length)",
          "title": "Max Length"
        },
        "min_distance_bp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "remove records closer than this to a planted variant; null = constraints.min_distance_bp",
          "title": "Min Distance Bp"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "release": {
          "title": "Release",
          "type": "string"
        },
        "require_pass": {
          "default": false,
          "description": "skip records with a FILTER other than PASS or missing (.)",
          "title": "Require Pass",
          "type": "boolean"
        },
        "restrict_to_bed": {
          "default": false,
          "description": "skip records whose REF span is not inside the BED",
          "title": "Restrict To Bed",
          "type": "boolean"
        },
        "sample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "VCF sample column; null = the first",
          "title": "Sample"
        },
        "sex": {
          "$ref": "#/$defs/Sex",
          "description": "sex of the background individual (HG002: male)"
        },
        "spanning_deletion": {
          "default": "skip",
          "description": "'*' alleles: skip the whole record, or read them as REF on their haplotype",
          "enum": [
            "skip",
            "ref"
          ],
          "title": "Spanning Deletion",
          "type": "string"
        },
        "vcf": {
          "description": "bgzipped + tabix-indexed VCF",
          "title": "Vcf",
          "type": "string"
        }
      },
      "required": [
        "name",
        "vcf",
        "bed",
        "release",
        "sex"
      ],
      "title": "BackgroundConfig",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "pathogenic",
        "likely_pathogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "title": "Classification",
      "type": "string"
    },
    "ClinGenErepoSource": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "tab-delimited eRepo download",
          "title": "File",
          "type": "string"
        },
        "held_out_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeldOutReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "release": {
          "title": "Release",
          "type": "string"
        }
      },
      "required": [
        "file",
        "release"
      ],
      "title": "ClinGenErepoSource",
      "type": "object"
    },
    "ClinGenRule": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/VariantCategory"
        },
        "classification_allow": {
          "items": {
            "$ref": "#/$defs/Classification"
          },
          "minItems": 1,
          "title": "Classification Allow",
          "type": "array"
        },
        "compound_het": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompoundHet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "conditions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MONDO ids",
          "title": "Conditions"
        },
        "count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "erepo_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Erepo Ids"
        },
        "exclude_strata": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude Strata"
        },
        "expected": {
          "$ref": "#/$defs/ExpectedSpec"
        },
        "genes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Genes"
        },
        "held_out": {
          "default": "include",
          "enum": [
            "include",
            "exclude",
            "only"
          ],
          "title": "Held Out",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "ladder_per_bin": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ladder Per Bin"
        },
        "per_gene": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Gene"
        },
        "region_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Bed"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "samples": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Samples",
          "type": "array"
        },
        "source": {
          "const": "clingen_erepo",
          "title": "Source",
          "type": "string"
        },
        "strata": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strata"
        },
        "variant_types": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VariantType"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Types"
        },
        "vceps": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vceps"
        },
        "zygosity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Zygosity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "category",
        "samples",
        "expected",
        "source",
        "classification_allow"
      ],
      "title": "ClinGenRule",
      "type": "object"
    },
    "ClinVarRule": {
