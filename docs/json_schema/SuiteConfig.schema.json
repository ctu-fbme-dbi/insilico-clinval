      "type": "object"
    },
    "HeldOutReference": {
      "additionalProperties": false,
      "description": "The held-out reference release; alleles absent from it are ``held_out``.",
      "properties": {
        "file": {
          "description": "eRepo export of that release (needs a Uuid or CAID column), or a GRCh38 VCF of its alleles (.vcf, .vcf.gz; matched by left-normalized allele)",
          "title": "File",
          "type": "string"
        },
        "release": {
          "description": "e.g. v2.2.0 (the release BIAS-2015 was tuned on)",
          "title": "Release",
          "type": "string"
        }
      },
      "required": [
        "release",
        "file"
      ],
      "title": "HeldOutReference",
      "type": "object"
    },
    "OutputConfig": {
      "additionalProperties": false,
      "properties": {
        "directory": {
          "title": "Directory",
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "title": "OutputConfig",
      "type": "object"
    },
    "Phase": {
      "description": "Relative phase of the members of a compound-heterozygous phase set.",
      "enum": [
        "cis",
        "trans"
      ],
      "title": "Phase",
      "type": "string"
    },
    "PhaseSetSpec": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "variants": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "variants",
        "phase"
      ],
      "title": "PhaseSetSpec",
      "type": "object"
    },
    "ReferenceConfig": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "const": "GRCh38",
          "title": "Build",
          "type": "string"
        },
        "fasta": {
          "title": "Fasta",
          "type": "string"
        },
        "par_regions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Region"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pseudo-autosomal regions; null = GRCh38 PAR1/PAR2 (see constants.py)",
          "title": "Par Regions"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "build",
        "fasta"
      ],
      "title": "ReferenceConfig",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "1-based, closed interval.",
      "properties": {
        "chrom": {
          "title": "Chrom",
          "type": "string"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "chrom",
        "start",
        "end"
      ],
      "title": "Region",
      "type": "object"
    },
    "SampleConfig": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "merge the suite background; null = yes if one is configured",
          "title": "Background"
        },
        "default_zygosity": {
          "default": "het",
          "enum": [
            "het",
            "hom"
          ],
          "title": "Default Zygosity",
          "type": "string"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/VariantOverride"
          },
          "title": "Overrides",
          "type": "array"
        },
        "phase_sets": {
          "items": {
            "$ref": "#/$defs/PhaseSetSpec"
          },
          "title": "Phase Sets",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/SampleRole"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Sample Id",
          "type": "string"
        },
        "sex": {
          "$ref": "#/$defs/Sex"
        }
      },
      "required": [
        "sample_id",
        "role",
        "sex"
      ],
      "title": "SampleConfig",
      "type": "object"
    },
    "SampleRole": {
      "enum": [
        "positive",
        "negative",
        "mixed"
      ],
      "title": "SampleRole",
      "type": "string"
    },
    "Sex": {
      "enum": [
        "female",
        "male"
      ],
      "title": "Sex",
      "type": "string"
    },
    "SimulationConfig": {
      "additionalProperties": false,
      "description": "Read simulation: profile file and which part of the genome is simulated.",
      "properties": {
        "extra_regions_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "region mode: additional regions, e.g. paralogous loci",
          "title": "Extra Regions Bed"
        },
        "flank_bp": {
          "default": 1500,
          "description": "region mode: bases simulated on each side of a variant",
          "minimum": 0,
          "title": "Flank Bp",
          "type": "integer"
        },
        "genome_contigs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "genome mode: contigs to simulate; null = chr1-22, chrX, chrY",
          "title": "Genome Contigs"
        },
        "mason_batch_bp": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "split each ploidy group into Mason runs of consecutive whole segments of at most this many bp (a longer segment runs alone); caps Mason's temporary disk use; changes the reads; null = one Mason run per group",
          "title": "Mason Batch Bp"
        },
        "min_alt_reads": {
          "default": 1,
          "description": "planting check: alt reads required on each carrying haplotype",
          "minimum": 1,
          "title": "Min Alt Reads",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/SimulationMode",
          "default": "region"
        },
        "profile": {
          "description": "simulation profile YAML (configs/profiles/)",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "profile"
      ],
      "title": "SimulationConfig",
      "type": "object"
    },
    "SimulationMode": {
      "enum": [
        "region",
        "genome"
      ],
      "title": "SimulationMode",
      "type": "string"
    },
    "Sources": {
      "additionalProperties": false,
      "properties": {
        "clingen_erepo": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClinGenErepoSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "clinvar": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClinVarSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "giab": {
          "anyOf": [
            {
              "$ref": "#/$defs/GiabSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Strata",
          "type": "object"
        }
      },
      "title": "Sources",
      "type": "object"
    },
    "SuiteInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "seed"
      ],
      "title": "SuiteInfo",
      "type": "object"
    },
    "VariantCategory": {
      "enum": [
        "standard",
        "curated",
        "difficult",
        "synthetic_novel"
      ],
      "title": "VariantCategory",
      "type": "string"
    },
    "VariantOverride": {
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        },
        "zygosity": {
          "$ref": "#/$defs/Zygosity"
        }
      },
      "required": [
        "variant_id",
        "zygosity"
      ],
      "title": "VariantOverride",
      "type": "object"
    },
    "VariantType": {
      "enum": [
        "snv",
        "mnv",
        "insertion",
        "deletion",
        "delins"
      ],
      "title": "VariantType",
      "type": "string"
    },
    "Zygosity": {
      "enum": [
        "het",
        "hom",
        "hemi"
      ],
      "title": "Zygosity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "background": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackgroundConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "output": {
      "$ref": "#/$defs/OutputConfig"
    },
    "reference": {
      "$ref": "#/$defs/ReferenceConfig"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/SampleConfig"
      },
      "minItems": 1,
      "title": "Samples",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection": {
      "items": {
        "discriminator": {
          "mapping": {
            "clingen_erepo": "#/$defs/ClinGenRule",
            "clinvar": "#/$defs/ClinVarRule",
            "explicit": "#/$defs/ExplicitRule",
            "giab": "#/$defs/GiabRule"
          },
          "propertyName": "source"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ClinGenRule"
          },
          {
            "$ref": "#/$defs/ClinVarRule"
          },
          {
            "$ref": "#/$defs/GiabRule"
          },
          {
            "$ref": "#/$defs/ExplicitRule"
          }
        ]
      },
      "minItems": 1,
      "title": "Selection",
      "type": "array"
    },
    "simulation": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimulationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "suite": {
      "$ref": "#/$defs/SuiteInfo"
    }
  },
  "required": [
    "schema_version",
    "suite",
    "reference",
    "sources",
    "constraints",
    "selection",
    "samples",
    "output"
  ],
  "title": "SuiteConfig",
  "type": "object"
}
