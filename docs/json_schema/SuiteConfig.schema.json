          "title": "Ladder Per Bin"
        },
        "min_stars": {
          "default": 0,
          "maximum": 4,
          "minimum": 0,
          "title": "Min Stars",
          "type": "integer"
        },
        "per_gene": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Gene"
        },
        "region_bed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Bed"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "rsids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsids"
        },
        "samples": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Samples",
          "type": "array"
        },
        "source": {
          "const": "clinvar",
          "title": "Source",
          "type": "string"
        },
        "strata": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strata"
        },
        "variant_types": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VariantType"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Types"
        },
        "variation_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
