          "type": "string"
        },
        "ref": {
          "pattern": "^[ACGTacgt]+$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "chrom",
        "pos",
        "ref",
        "alt",
        "rationale"
      ],
      "title": "ExplicitVariant",
      "type": "object"
    },
