        "release"
      ],
      "title": "ClinVarSource",
      "type": "object"
    },
    "CompoundHet": {
      "additionalProperties": false,
      "description": "Pair selected variants of the same gene (in rank order) into phase sets.",
      "properties": {
        "phase": {
          "$ref": "#/$defs/Phase"
        }
      },
      "required": [
        "phase"
      ],
      "title": "CompoundHet",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_variant_types": {
          "items": {
            "$ref": "#/$defs/VariantType"
          },
          "title": "Allowed Variant Types",
          "type": "array"
        },
        "indel_ladder": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Indel Ladder",
          "type": "array"
        },
        "max_indel_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Indel Length"
        },
        "min_distance_bp": {
          "minimum": 0,
          "title": "Min Distance Bp",
          "type": "integer"
        }
      },
      "required": [
        "min_distance_bp",
        "allowed_variant_types"
      ],
      "title": "Constraints",
      "type": "object"
    },
    "EvaluationLevel": {
      "enum": [
        "calling",
        "interpretation",
        "both"
      ],
      "title": "EvaluationLevel",
      "type": "string"
    },
    "ExpectedSpec": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "classification": {
          "description": "acceptable classifications",
          "items": {
            "$ref": "#/$defs/Classification"
          },
          "title": "Classification",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/EvaluationLevel"
        },
        "reportable": {
          "title": "Reportable",
          "type": "boolean"
        }
      },
      "required": [
        "reportable",
        "level"
      ],
      "title": "ExpectedSpec",
      "type": "object"
    },
    "ExplicitRule": {
