{
  "$defs": {
    "ConfigRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ConfigRef",
      "type": "object"
    },
    "DatabaseRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "release": {
          "title": "Release",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        }
      },
      "required": [
        "name",
        "release",
        "sha256"
      ],
      "title": "DatabaseRef",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "FrameworkInfo": {
      "additionalProperties": false,
      "properties": {
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Git Commit"
        },
        "python_packages": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "versions of Python libraries that shape output bytes (pysam, isal)",
          "title": "Python Packages",
          "type": "object"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "git_commit",
        "dirty"
      ],
      "title": "FrameworkInfo",
      "type": "object"
    },
    "StepRecord": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "peak_rss_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Peak Rss Mb"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "wall_s": {
          "title": "Wall S",
          "type": "number"
        }
      },
      "required": [
        "name",
        "started_at",
        "wall_s",
        "peak_rss_mb",
        "exit_code"
      ],
      "title": "StepRecord",
      "type": "object"
    },
    "ToolRef": {
      "additionalProperties": false,
      "properties": {
        "container_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Digest"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Mutable while a command runs; extended by every command writing into the run directory.",
  "properties": {
    "config": {
      "$ref": "#/$defs/ConfigRef"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "databases": {
      "items": {
        "$ref": "#/$defs/DatabaseRef"
      },
      "title": "Databases",
      "type": "array"
    },
    "framework": {
      "$ref": "#/$defs/FrameworkInfo"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepRecord"
      },
      "title": "Steps",
      "type": "array"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolRef"
      },
      "title": "Tools",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "framework",
    "config",
    "seed",
    "inputs",
    "outputs",
    "tools",
    "databases",
    "steps",
    "warnings"
  ],
  "title": "RunManifest",
  "type": "object"
}
