{
  "$defs": {
    "BackgroundInfo": {
      "additionalProperties": false,
      "description": "Background genome merged into the truth VCF (e.g. GIAB HG002 v4.2.1).",
      "properties": {
        "bed": {
          "description": "as configured in the suite",
          "title": "Bed",
          "type": "string"
        },
        "min_distance_bp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "gap used for the removal (null in runs built before it was set)",
          "title": "Min Distance Bp"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "planted_outside_bed": {
          "description": "planted variant ids outside the background high-confidence BED",
          "items": {
            "type": "string"
          },
          "title": "Planted Outside Bed",
          "type": "array"
        },
        "records": {
          "description": "background records written to the truth VCF (before split)",
          "title": "Records",
          "type": "integer"
        },
        "release": {
          "title": "Release",
          "type": "string"
        },
        "removed": {
          "description": "records removed within min_distance_bp of planted variants",
          "title": "Removed",
          "type": "integer"
        },
        "removed_log": {
          "description": "TSV of removed records, relative to the run directory",
          "title": "Removed Log",
          "type": "string"
        },
        "skipped": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "background records skipped, by reason",
          "title": "Skipped",
          "type": "object"
        },
        "spanning_deletion_to_ref": {
          "default": 0,
          "description": "'*' alleles read as REF (spanning_deletion: ref)",
          "title": "Spanning Deletion To Ref",
          "type": "integer"
        },
        "vcf": {
          "description": "as configured in the suite",
          "title": "Vcf",
          "type": "string"
        }
      },
      "required": [
        "name",
        "release",
        "vcf",
        "bed",
        "records",
        "removed",
        "removed_log",
        "planted_outside_bed"
      ],
      "title": "BackgroundInfo",
      "type": "object"
    },
    "Haplotype": {
      "enum": [
        "1",
        "2",
        "both"
      ],
      "title": "Haplotype",
      "type": "string"
    },
    "SampleRole": {
      "enum": [
        "positive",
        "negative",
        "mixed"
      ],
      "title": "SampleRole",
      "type": "string"
    },
    "SampleVariant": {
      "additionalProperties": false,
      "properties": {
        "haplotype": {
          "$ref": "#/$defs/Haplotype"
        },
        "phase_set": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "VCF PS value (position of the first member); null if none",
          "title": "Phase Set"
        },
        "variant_id": {
          "title": "Variant Id",
          "type": "string"
        },
        "zygosity": {
          "$ref": "#/$defs/Zygosity"
        }
      },
      "required": [
        "variant_id",
        "zygosity",
        "haplotype"
      ],
      "title": "SampleVariant",
      "type": "object"
    },
    "Sex": {
      "enum": [
        "female",
        "male"
      ],
      "title": "Sex",
      "type": "string"
    },
    "Zygosity": {
      "enum": [
        "het",
        "hom",
        "hemi"
      ],
      "title": "Zygosity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "background": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackgroundInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_outcomes": {
      "description": "path relative to the run directory",
      "title": "Expected Outcomes",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/SampleRole"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "sex": {
      "$ref": "#/$defs/Sex"
    },
    "truth_vcf": {
      "description": "path relative to the run directory",
      "title": "Truth Vcf",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/SampleVariant"
      },
      "title": "Variants",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "role",
    "sex",
    "variants",
    "truth_vcf",
    "expected_outcomes"
  ],
  "title": "SampleSpec",
  "type": "object"
}
