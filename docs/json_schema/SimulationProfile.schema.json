{
  "$defs": {
    "FragmentModel": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "maximum size (uniform model)",
          "title": "Max"
        },
        "mean": {
          "description": "mean fragment (insert) size, bp",
          "minimum": 1,
          "title": "Mean",
          "type": "integer"
        },
        "min": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "minimum size (uniform model)",
          "title": "Min"
        },
        "model": {
          "default": "normal",
          "enum": [
            "normal",
            "uniform"
          ],
          "title": "Model",
          "type": "string"
        },
        "sd": {
          "description": "standard deviation (normal model)",
          "minimum": 0,
          "title": "Sd",
          "type": "integer"
        }
      },
      "required": [
        "mean",
        "sd"
      ],
      "title": "FragmentModel",
      "type": "object"
    },
    "IlluminaErrors": {
      "additionalProperties": false,
      "description": "Optional Mason Illumina error-model parameters; null = Mason's default.",
      "properties": {
        "prob_deletion": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prob Deletion"
        },
        "prob_insert": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prob Insert"
        },
        "prob_mismatch": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prob Mismatch"
        },
        "prob_mismatch_begin": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prob Mismatch Begin"
        },
        "prob_mismatch_end": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prob Mismatch End"
        },
        "prob_mismatch_scale": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prob Mismatch Scale"
        }
      },
      "title": "IlluminaErrors",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Read-simulation parameters (configs/profiles/*.yaml).",
  "properties": {
    "chunk_size": {
      "default": 65536,
      "minimum": 65536,
      "title": "Chunk Size",
      "type": "integer"
    },
    "coverage": {
      "description": "mean depth of a diploid locus (both haplotypes)",
      "exclusiveMinimum": 0,
      "title": "Coverage",
      "type": "number"
    },
    "fragment": {
      "$ref": "#/$defs/FragmentModel"
    },
    "illumina": {
      "$ref": "#/$defs/IlluminaErrors"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "read_length": {
      "minimum": 20,
      "title": "Read Length",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "technology": {
      "const": "illumina",
      "title": "Technology",
      "type": "string"
    },
    "threads": {
      "default": 1,
      "description": "Mason threads; part of the determinism key (one RNG each)",
      "minimum": 1,
      "title": "Threads",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "name",
    "technology",
    "read_length",
    "fragment",
    "coverage"
  ],
  "title": "SimulationProfile",
  "type": "object"
}
