{
  "$defs": {
    "CanonicalFinding": {
      "additionalProperties": false,
      "properties": {
        "acmg_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Acmg Criteria",
          "type": "array"
        },
        "alt": {
          "title": "Alt",
          "type": "string"
        },
        "chrom": {
          "title": "Chrom",
          "type": "string"
        },
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Classification"
            },
            {
              "type": "null"
            }
          ]
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gene"
        },
        "hgvs_c": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hgvs C"
        },
        "hgvs_p": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hgvs P"
        },
        "pos": {
          "title": "Pos",
          "type": "integer"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "reported": {
          "title": "Reported",
          "type": "boolean"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "chrom",
        "pos",
        "ref",
        "alt",
        "classification",
        "reported",
        "tool",
        "tool_version"
      ],
      "title": "CanonicalFinding",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "pathogenic",
        "likely_pathogenic",
        "uncertain_significance",
        "likely_benign",
        "benign"
      ],
      "title": "Classification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persisted as `sut/<pipeline>/<sample_id>.findings.json` (findings sorted by position).",
  "properties": {
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/CanonicalFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_vcf": {
      "description": "tertiary input VCF, relative to the run directory",
      "title": "Input Vcf",
      "type": "string"
    },
    "pipeline": {
      "title": "Pipeline",
      "type": "string"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "integer"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "pipeline",
    "adapter",
    "tool",
    "tool_version",
    "input_vcf",
    "findings"
  ],
  "title": "FindingSet",
  "type": "object"
}
